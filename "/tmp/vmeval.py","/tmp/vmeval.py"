import json, sys, urllib.parse
sys.path.insert(0, '/tmp')
from vmclient import rpc, get_isolate


def eval_in_app(code, isolate=None):
    """Evaluate Dart code in the app's main isolate."""
    iso = isolate or get_isolate()
    r = rpc('evaluate', {
        'isolateId': iso,
        'targetId': 'libraries/@0150898',   # dart:core
        'expression': code,
    })
    return r


if __name__ == '__main__':
    code = sys.argv[1] if len(sys.argv) > 1 else '1+1'
    r = eval_in_app(code)
    print(json.dumps(r)[:3000])
